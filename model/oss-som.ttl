#################################################################
#    Object Properties
#################################################################

###  https://www.semanticweb.org/sergey/ontologies/osssom/core#derivedFrom
osssom:derivedFrom rdf:type owl:ObjectProperty ,
                            owl:TransitiveProperty .


###  https://www.semanticweb.org/sergey/ontologies/osssom/core#succeededBy
osssom:succeededBy rdf:type owl:ObjectProperty ;
                   owl:inverseOf osssom:supersedes .


###  https://www.semanticweb.org/sergey/ontologies/osssom/core#supersedes
osssom:supersedes rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  https://www.semanticweb.org/sergey/ontologies/osssom/core#Actor
osssom:Actor rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> .


###  https://www.semanticweb.org/sergey/ontologies/osssom/core#Commit
osssom:Commit rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> .


###  https://www.semanticweb.org/sergey/ontologies/osssom/core#MetricDefinition
osssom:MetricDefinition rdf:type owl:Class ;
                        rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty> .


###  https://www.semanticweb.org/sergey/ontologies/osssom/core#MetricObservation
osssom:MetricObservation rdf:type owl:Class ;
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> .


###  https://www.semanticweb.org/sergey/ontologies/osssom/core#SoftwareProduct
osssom:SoftwareProduct rdf:type owl:Class ;
                       rdfs:subClassOf <http://usefulinc.com/ns/doap#Project> .


