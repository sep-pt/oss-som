<https://www.semanticweb.org/sergey/ontologies/osssom/core> rdf:type owl:Ontology ;
                                                             owl:versionIRI <https://www.semanticweb.org/sergey/ontologies/osssom/1.0/core> ;
                                                             owl:imports <http://usefulinc.com/ns/doap#> ,
                                                                         <http://www.w3.org/2004/02/skos/core> ,
